<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>VoicePlugin</AssemblyName>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <!-- 编译后自动打包 .icpx 插件包；打包目标与 manifest.json 复制
         均由 InkCanvas.PluginSdk 包提供（build/net10.0-windows.../*.targets）。 -->
    <CreateIcpx>true</CreateIcpx>
    <IcpxOutputDirectory Condition="'$(IcpxOutputDirectory)'==''">$(MSBuildProjectDirectory)\icpx</IcpxOutputDirectory>
    <IcpxPackageName Condition="'$(IcpxPackageName)'==''">$(MSBuildProjectName).icpx</IcpxPackageName>
    <!-- 符号嵌入程序集，避免 .pdb 文件进入插件包 -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- EdgeTTS.DotNet 需随插件分发；不开 CopyLocalLockFileAssemblies
         （否则 SDK/DI/WinRT 运行库也会被复制进包），这里显式从
         NuGet 缓存复制所需的那一个程序集到输出目录。 -->
    <None Include="$(NuGetPackageRoot)edgetts.dotnet\0.4.0\lib\net10.0\EdgeTTS.DotNet.dll"
          Link="EdgeTTS.DotNet.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK 与宿主共用控件库改从 NuGet 引用（宿主同版本发布，包内已是
         net10.0-windows10.0.19041 目标，与本插件 TFM 一致）。
         PrivateAssets=all 确保宿主共享程序集不会被打进 .icpx：运行时统一
         绑定宿主内嵌副本（宿主 PluginLoadContext 会先从默认上下文共享）。 -->
    <PackageReference Include="InkCanvas.PluginSdk" Version="1.8.0.8-g90c1bad8f3" PrivateAssets="all" />
    <PackageReference Include="InkCanvas.Controls" Version="1.8.0.8-g90c1bad8f3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" PrivateAssets="all" />
    <!-- EdgeTTS.DotNet 0.4.0 仅提供 net9.0/net10.0 目标，因此本插件
         必须保持 net10.0-windows TFM（宿主为 net10，可直接加载）。 -->
    <PackageReference Include="EdgeTTS.DotNet" Version="0.4.0" />
  </ItemGroup>

</Project>
